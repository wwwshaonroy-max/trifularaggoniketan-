rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Basic authentication requirement for all collections
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Specific rules for tracking diary numbers to enforce absolute uniqueness
    match /diaryNumbers/{diaryId} {
      // Allow read if authenticated
      allow read: if request.auth != null;
      
      // Allow create only if the diary number doesn't already exist
      allow create: if request.auth != null && !exists(/databases/$(database)/documents/diaryNumbers/$(diaryId));
      
      // Allow update and delete if authenticated
      allow update, delete: if request.auth != null;
    }
  }
}
